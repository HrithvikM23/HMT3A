        SP3 --> SP4["Create VideoOutputWriter"]
        SP4 --> SP5["Create ONNXPoseHandRunner"]
        SP5 --> SP6["Create LandmarkSmoother"]
        SP6 --> SP7["Create OSCSender"]
        SP7 --> SP8["Create PoseHandPipeline"]
        SP8 --> SP9["Initialize motion_frames and frame_index"]
        SP9 --> SP10["session.read()"]
        SP10 --> SP11{"Frame available?"}
        SP11 -->|No| SP_END_LOOP["End frame loop"]
        SP11 -->|Yes| SP12["pipeline.detect_pose(frame)"]
        SP12 --> PIPE_START
        PIPE_DONE --> SP13{"single_camera_depth is mediapipe?"}
        SP13 -->|Yes| SP14["Use pipeline.last_joint_depths"]
        SP13 -->|No| SP15["Use no joint depths"]
        SP14 --> SP16["build_joint_map(body_points, hands_by_side, joint_depths)"]
        SP15 --> SP16
        SP16 --> SP17["pipeline.render_pose(send_osc=false)"]
        SP17 --> SP18["osc_sender.send_pose() with metadata"]
        SP18 --> SP19["Append motion frame with frame_index and joints"]
        SP19 --> SP20["fps_meter.tick()"]
        SP20 --> SP21["draw_fps_overlay()"]
        SP21 --> SP22["session.write(frame)"]
        SP22 --> SP23{"Preview enabled?"}
        SP23 -->|No| SP24["Increment frame_index"]
        SP23 -->|Yes| SP25["cv2.imshow()"]
        SP25 --> SP26{"ESC pressed?"}
        SP26 -->|Yes| SP_END_LOOP
        SP26 -->|No| SP24
        SP24 --> SP10
        SP_END_LOOP --> SP27["Close capture, writer, OSC, windows"]
        SP27 --> SP28["export_motion_bundle(config, fps, frames, metadata)"]
        SP28 --> EXPORT_SINGLE_START
    end

    subgraph PIPE["PoseHandPipeline.detect_pose"]
        PIPE_START["detect_pose(frame)"] --> PIPE1["_build_inference_frame(frame)"]
        PIPE1 --> PIPE2{"processing_width downscales source?"}
        PIPE2 -->|Yes| PIPE3["Resize frame for inference"]
        PIPE2 -->|No| PIPE4["Use original frame"]
        PIPE3 --> PIPE5["Return inference_frame and output scales"]
        PIPE4 --> PIPE5
        PIPE5 --> PIPE6{"Run body model this frame?"}
        PIPE6 -->|Yes| PIPE7["runner.detect_body(inference_frame)"]
        PIPE7 --> PIPE8["Scale raw body points to output frame"]
        PIPE8 --> PIPE9["smoother.smooth_body()"]
        PIPE9 --> PIPE10["Scale runner.last_body_depths"]
        PIPE6 -->|No| PIPE11["predict_points(last_body, previous_body, decay)"]
        PIPE11 --> PIPE12["Reuse previous joint depths"]
        PIPE10 --> PIPE13{"Body points available?"}
        PIPE12 --> PIPE13
        PIPE13 -->|No| PIPE14["Create 17 zero-confidence body points"]
        PIPE13 -->|Yes| PIPE15["Use smoothed or predicted body"]
        PIPE14 --> PIPE16["Apply BodyKinematicConstraints"]
        PIPE15 --> PIPE16
        PIPE16 --> PIPE17["Update previous and last body caches"]
        PIPE17 --> PIPE18["Update last_joint_depths"]
        PIPE18 --> PIPE19["Scale body to inference space for hand crops"]
        PIPE19 --> HAND_START
        HAND_DONE --> PIPE20["Increment internal frame index"]
        PIPE20 --> PIPE_DONE["Return body_points and hands_by_side"]
    end

    subgraph HAND["Hand Detection And Fallback"]
        HAND_START["detect_hands(frame, body_points, output_scale)"] --> HAND1["Get frame size"]
        HAND1 --> HAND2{"Run hand model this frame?"}
        HAND2 --> HAND3["Loop over left/right wrist-elbow pairs"]
        HAND3 --> HAND4["Read wrist and elbow body points"]
        HAND4 --> HAND5{"Wrist and elbow confident?"}
        HAND5 -->|No| HAND_MORE{"More sides?"}
        HAND5 -->|Yes| HAND6["Build primary hand crop box"]
        HAND6 --> HAND7{"Run hand model?"}
        HAND7 -->|Yes| HAND8["Build candidate crop boxes"]
        HAND8 --> HAND9["runner.detect_hand() for candidate"]
        HAND9 --> HAND10{"Usable detection?"}
        HAND10 -->|No| HAND11{"More candidate boxes?"}
        HAND10 -->|Yes| HAND12["Anchor raw hand to wrist"]
        HAND12 --> HAND13["Enforce hand constraints"]
        HAND13 --> HAND14["Score candidate confidence and validity"]
        HAND14 --> HAND11
        HAND11 -->|Yes| HAND9
        HAND11 -->|No| HAND15{"Best candidate found?"}
        HAND7 -->|No| HAND16["Predict hand from previous wrist motion"]
        HAND15 -->|Yes| HAND17["Use detected hand points and depths"]
        HAND15 -->|No| HAND18{"Backend fallbacks enabled?"}
        HAND18 -->|Yes| HAND16
        HAND18 -->|No| HAND19["No raw hand points"]
        HAND16 --> HAND20{"Prediction available?"}
        HAND20 -->|Yes| HAND21["Translate previous hand box and points"]
        HAND20 -->|No| HAND19
        HAND21 --> HAND17
        HAND17 --> HAND22["smoother.smooth_hand()"]
        HAND19 --> HAND22
        HAND22 --> HAND23{"Smoothed hand exists?"}
        HAND23 -->|Yes| HAND24["Enforce hand constraints again"]
        HAND24 --> HAND25{"Hand detection valid?"}
        HAND25 -->|Yes| HAND26["Use constrained hand"]
        HAND25 -->|No| HAND27["Discard hand and depths"]
        HAND23 -->|No| HAND27
        HAND27 --> HAND28["generate_default_hand() from wrist and elbow"]
        HAND28 --> HAND29["Enforce fallback hand constraints"]
        HAND26 --> HAND30["Create HandPayload"]
        HAND29 --> HAND30
        HAND30 --> HAND31{"Depths match hand point count?"}
        HAND31 -->|Yes| HAND32["Store hand depths in last_joint_depths"]
        HAND31 -->|No| HAND33["Skip hand depths"]
        HAND32 --> HAND34["Cache last hand and wrist"]
        HAND33 --> HAND34
        HAND34 --> HAND_MORE
        HAND_MORE -->|Yes| HAND3
        HAND_MORE -->|No| HAND_DONE["Return hands_by_side"]
    end

    subgraph EXPORT_SINGLE["Single-Person Export Bundle"]
