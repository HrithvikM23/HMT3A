flowchart TD
    START["Start: python main.py"] --> CLI1["build_parser(): create CLI parser"]
    CLI1 --> CLI2["explicit_option_dests(): detect CLI options typed by user"]
    CLI2 --> CLI3["parse_args(): parse command line arguments"]
    CLI3 --> PROF1["apply_runtime_profile(): fastest, mid, or quality"]
    PROF1 --> BOOT1["ensure_runtime_ready(): prepare runtime"]

    subgraph BOOT["Runtime Bootstrap"]
        BOOT1 --> BOOT2["Verify expected repo files"]
        BOOT2 --> BOOT3["Create local support folders"]
        BOOT3 --> BOOT4["Add .vendor_py311 to sys.path"]
        BOOT4 --> BOOT5["Set PYTHONPATH and runtime environment"]
        BOOT5 --> BOOT6["Search NVIDIA runtime paths"]
        BOOT6 --> BOOT7["Find nvidia-smi, CUDA, cuDNN, torch DLL folders"]
        BOOT7 --> BOOT8["Prepend discovered folders to PATH"]
        BOOT8 --> BOOT9["Register DLL folders on Windows"]
        BOOT9 --> BOOT10["Probe required Python modules"]
        BOOT10 --> BOOT11{"Missing packages?"}
        BOOT11 -->|Yes| BOOT12["Install missing packages into .vendor_py311"]
        BOOT11 -->|No| BOOT13["Skip package install"]
        BOOT12 --> BOOT14["Re-probe installed modules"]
        BOOT13 --> BOOT14
        BOOT14 --> BOOT15["Probe ONNX Runtime providers"]
        BOOT15 --> BOOT16["Runtime ready"]
    end

    BOOT16 --> IMPORTS["Import calibration, runners, and config builders"]
    IMPORTS --> SRC1["resolve_sources(args)"]

    subgraph SRC["Input Source Resolution"]
        SRC1 --> SRC2{"Was --source provided?"}
        SRC2 -->|Yes| SRC3["Loop through each --source value"]
        SRC3 --> SRC4{"Value contains label=value?"}
        SRC4 -->|Yes| SRC5["Split into label and source text"]
        SRC4 -->|No| SRC6["Use default label CAM_N"]
        SRC5 --> SRC7["Normalize label with sanitize_label().upper()"]
        SRC6 --> SRC7
        SRC7 --> SRC8{"Duplicate label?"}
        SRC8 -->|Yes| SRC9["Print duplicate source error"]
        SRC9 --> SRC_END_EMPTY["Return empty assignment list"]
        SRC8 -->|No| SRC10{"Source text is digits?"}
        SRC10 -->|Yes| SRC11["Create webcam InputAssignment"]
        SRC10 -->|No| SRC12["Create Path from source text"]
        SRC12 --> SRC13{"Path exists?"}
        SRC13 -->|No| SRC14["Print file not found error"]
        SRC14 --> SRC_END_EMPTY
        SRC13 -->|Yes| SRC15["Create video InputAssignment"]
        SRC11 --> SRC16{"More --source values?"}
        SRC15 --> SRC16
        SRC16 -->|Yes| SRC3
        SRC16 -->|No| SRC_END_OK["Return assignments"]

        SRC2 -->|No| SRC20["Interactive prompt: select input source"]
        SRC20 --> SRC21{"User selects webcam?"}
        SRC21 -->|Yes| SRC22["Ask webcam index"]
        SRC22 --> SRC23["Return FRONT webcam assignment"]
        SRC21 -->|No| SRC24{"User selects video files?"}
        SRC24 -->|No| SRC25["Print invalid choice"]
        SRC25 --> SRC_END_EMPTY
        SRC24 -->|Yes| SRC26["choose_camera_assignments_gui()"]
        SRC26 --> SRC27["Ask camera count from 1 to 4"]
        SRC27 --> SRC28["Assign logical camera labels"]
        SRC28 --> SRC29["Open file picker for each label"]
        SRC29 --> SRC30{"All files selected?"}
        SRC30 -->|No| SRC_END_EMPTY
        SRC30 -->|Yes| SRC_END_OK
        SRC23 --> SRC_END_OK
    end

    SRC_END_EMPTY --> EXIT["Return / exit program"]
    SRC_END_OK --> HAS_SRC{"Assignments found?"}
    HAS_SRC -->|No| EXIT
    HAS_SRC -->|Yes| CAL_CHECK{"args.calibrate_cameras?"}

    subgraph CAL["Camera Calibration Mode"]
        CAL_CHECK -->|Yes| CAL1["calibration_available()"]
        CAL1 --> CAL2{"Calibration support installed?"}
        CAL2 -->|No| CAL3["Print calibration support error"]
        CAL3 --> EXIT
        CAL2 -->|Yes| CAL4["Resolve calibration output path"]
        CAL4 --> CAL5{"Output path valid?"}
        CAL5 -->|No| CAL6["Print --calibration-output required error"]
        CAL6 --> EXIT
        CAL5 -->|Yes| CAL7["calibrate_cameras(assignments, output_path, Charuco settings)"]
        CAL7 --> CAL8["Read synchronized Charuco videos"]
        CAL8 --> CAL9["Detect board corners"]
        CAL9 --> CAL10["Estimate camera parameters"]
        CAL10 --> CAL11["Save camera_calibration.toml"]
        CAL11 --> CAL12["Save quality JSON if available"]
        CAL12 --> EXIT
    end

    CAL_CHECK -->|No| MODE1{"More than one input source?"}
    MODE1 -->|Yes| FUSED_START["run_fused_assignments(assignments, args)"]
    MODE1 -->|No| CFG1["build_config_for_assignment(args, assignment, false)"]

    subgraph CFG["Pipeline Configuration"]
        CFG1 --> CFG2["resolve_backend_selection(): body and hand backends"]
        CFG2 --> CFG3["resolve_body_model_settings()"]
        CFG3 --> CFG4["Resolve output basename and paths"]
        CFG4 --> CFG5["Create PipelineConfig"]
        CFG5 --> CFG6["prepare_runtime_config(config)"]
        CFG6 --> CFG7["apply_auto_performance(): choose CUDA/half when available"]
        CFG7 --> CFG8["prepare_model_assets(config)"]
        CFG8 --> CFG9["Download or locate YOLO body model if needed"]
        CFG9 --> CFG10["Download or locate MediaPipe pose/hand assets if needed"]
        CFG10 --> CFG11["Download or locate ONNX hand model if needed"]
        CFG11 --> CFG12["validate_config(config)"]
        CFG12 --> CFG13{"Config valid?"}
        CFG13 -->|No| CFG_BAD["Print validation error and return"]
        CFG13 -->|Yes| CFG_OK["Config ready"]
    end

    CFG_BAD --> EXIT
    CFG_OK --> SINGLE_ENTRY["run_assignment(config)"]
    SINGLE_ENTRY --> SINGLE_MODE{"config.max_people > 1?"}
    SINGLE_MODE -->|Yes| MP_START["run_multi_person_assignment(config)"]
    SINGLE_MODE -->|No| SP_START["Single-person runtime setup"]

    subgraph SP["Single-Person Runtime"]
        SP_START --> SP1["Create VideoCaptureSession"]
        SP1 --> SP2["Open VideoInputSource with OpenCV"]
